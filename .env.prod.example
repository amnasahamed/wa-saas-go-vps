# Production environment for the single-VPS deployment.
#
#   cp .env.prod.example .env.prod && $EDITOR .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod is gitignored. Never commit it. Keep a copy in a password manager —
# losing JWT_SECRET logs every user out; losing POSTGRES_PASSWORD is worse.

# ---- Public identity ----------------------------------------------------
# Must already have an A record pointing at this VPS before first boot, or
# Caddy cannot complete the ACME challenge.
APP_DOMAIN=app.example.com
# Used for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# ---- Runtime ------------------------------------------------------------
# Keep this as "prod". It drives the Secure flag on the session cookie and the
# hard failure on a missing JWT_SECRET.
ENV=prod
LOG_LEVEL=info

# ---- Secrets ------------------------------------------------------------
# REQUIRED. Minimum 32 bytes; api refuses to boot without it outside dev.
#   openssl rand -base64 48
JWT_SECRET=

# REQUIRED. Used by the postgres container and the DATABASE_URL below.
#   openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# ---- Datastores ---------------------------------------------------------
POSTGRES_USER=niosengine
POSTGRES_DB=niosengine

# Host names resolve on the compose network. sslmode=disable is correct here:
# the traffic never leaves the Docker bridge. Keep POSTGRES_PASSWORD in sync.
DATABASE_URL=postgres://niosengine:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/niosengine?sslmode=disable
REDIS_URL=redis://redis:6379/0

# ---- WhatsApp bridge ----------------------------------------------------
# Identifies this worker for session sharding. Device state is stored per
# worker ID, so CHANGING THIS ORPHANS EXISTING SESSIONS and forces every tenant
# to re-link. Pick one and leave it alone.
BRIDGE_WORKER_ID=worker-1
BRIDGE_MAX_SESSIONS=50

# Maps worker IDs to their gRPC addresses so the api can route a send to the
# bridge that owns that tenant's session. Add one comma-separated entry per
# bridge container, e.g. worker-1=bridge:9090,worker-2=bridge2:9090
BRIDGE_GRPC_TARGETS=worker-1=bridge:9090

# ---- Service-to-service gRPC auth --------------------------------------
# REQUIRED outside dev (api and bridge refuse to boot without it). Used as
# the `x-api-key` metadata on every gRPC RPC in both directions. Generate
# one shared value and set it in BOTH the api and bridge env. The two halves
# of the link validate the same value.
#   openssl rand -base64 48
GRPC_SHARED_SECRET=

# Internal address of the API's gRPC listener. The bridge dials this to send
# inbound events. Default already matches docker-compose.prod.yml.
API_GRPC_ADDR=api:8081

# ---- Third-party (optional) --------------------------------------------
# Platform-level OpenAI key. Tenants can supply their own via the dashboard.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Billing is not implemented yet (Phase 2); leave blank until it is.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email sender. Email verification is not implemented yet, so
# this is currently unused.
SES_FROM_EMAIL=
