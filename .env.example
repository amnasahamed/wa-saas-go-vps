# Local development env. Copy to .env and edit.
# .env is gitignored; never commit secrets.

# Service identity
SERVICE_NAME=api
ENV=dev
LOG_LEVEL=debug

# HTTP
API_LISTEN_ADDR=:8080
BRIDGE_GRPC_ADDR=:9090

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/niosengine?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS / S3 (LocalStack for dev)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localhost:4566
S3_MEDIA_BUCKET=niosengine-media
AWS_KMS_KEY_ID=alias/niosengine-dev-tenant-secrets

# Bridge only
BRIDGE_WORKER_ID=local-dev
BRIDGE_MAX_SESSIONS=10
# Durable dir for per-session whatsmeow device state (signal keys). This is the
# only copy — losing it forces every tenant to re-scan a QR code.
BRIDGE_STATE_DIR=./data/bridge

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Stripe (api only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL of cmd/api (used for QR code links etc.)
INBOUND_API_BASE_URL=http://localhost:8080

# AWS SES (api only)
SES_FROM_EMAIL=dev@niosengine.local
